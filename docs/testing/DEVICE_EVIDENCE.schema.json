{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdubore/buzz-startos/blob/main/docs/testing/DEVICE_EVIDENCE.schema.json",
  "title": "Buzz StartOS Production Device Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "example",
    "gateId",
    "status",
    "releaseCandidate",
    "device",
    "execution",
    "stateHashes",
    "assertions",
    "evidence",
    "issues",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "example": {
      "type": "boolean"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[A-Z]{3,4}-[0-9]{2}$"
    },
    "status": {
      "enum": ["not-run", "pass", "fail", "blocked"]
    },
    "releaseCandidate": {
      "$ref": "#/$defs/releaseCandidate"
    },
    "device": {
      "$ref": "#/$defs/device"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "stateHashes": {
      "$ref": "#/$defs/stateHashes"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "authorizationRegression": {
      "$ref": "#/$defs/authorizationRegression"
    },
    "restoreTrials": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/restoreTrial"
      }
    },
    "upgradeSource": {
      "$ref": "#/$defs/upgradeSource"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "example": {
            "type": "boolean",
            "const": true
          }
        },
        "required": ["example"]
      },
      "then": {
        "properties": {
          "status": {
            "type": "string",
            "const": "not-run"
          },
          "evidence": {
            "type": "array",
            "maxItems": 0
          },
          "review": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "const": "pending"
              }
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "outcome": {
                  "type": "string",
                  "const": "not-run"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "blocked"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          },
          "review": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": ["approved", "rejected"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateId": {
            "const": "AUTH-02"
          }
        },
        "required": ["gateId"]
      },
      "then": {
        "required": ["authorizationRegression"]
      },
      "else": {
        "not": {
          "required": ["authorizationRegression"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateId": {
            "const": "BKP-01"
          }
        },
        "required": ["gateId"]
      },
      "then": {
        "required": ["restoreTrials"]
      },
      "else": {
        "not": {
          "required": ["restoreTrials"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateId": {
            "const": "UPG-01"
          }
        },
        "required": ["gateId"]
      },
      "then": {
        "required": ["upgradeSource"]
      },
      "else": {
        "not": {
          "required": ["upgradeSource"]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "packageVersion",
        "packageCommit",
        "upstreamCommit",
        "archive",
        "signerFingerprint",
        "manifestMinimumStartos",
        "sdkVersion"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[^\\s]+_[0-9]+$"
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^[^\\s]+:[0-9]+$"
        },
        "packageCommit": {
          "$ref": "#/$defs/commit"
        },
        "upstreamCommit": {
          "$ref": "#/$defs/commit"
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "sizeBytes"],
          "properties": {
            "name": {
              "enum": ["buzz_x86_64.s9pk", "buzz_aarch64.s9pk"]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "signerFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "manifestMinimumStartos": {
          "const": "0.4.0-beta.10"
        },
        "sdkVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "kind", "capacityBytes"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["ssd", "hdd", "nvme", "sd", "other"]
        },
        "capacityBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "startos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseLine",
        "releaseTag",
        "reportedVersion",
        "buildId",
        "officialSource",
        "sourceCommit",
        "imageSha256"
      ],
      "properties": {
        "releaseLine": {
          "const": "0.4.0"
        },
        "releaseTag": {
          "const": "start-os/v0.4.0"
        },
        "reportedVersion": {
          "type": "string",
          "pattern": "^0\\.4\\.0(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "officialSource": {
          "type": "string",
          "format": "uri"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "imageSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "role",
        "model",
        "cpu",
        "cores",
        "memoryBytes",
        "storage",
        "virtualization",
        "kernelVersion",
        "startos"
      ],
      "properties": {
        "architecture": {
          "enum": ["x86_64", "aarch64"]
        },
        "role": {
          "enum": ["primary", "restore-target", "upgrade-source"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/storage"
          }
        },
        "virtualization": {
          "enum": ["physical", "kvm", "other"]
        },
        "kernelVersion": {
          "type": "string",
          "minLength": 1
        },
        "startos": {
          "$ref": "#/$defs/startos"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args", "exitCode"],
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exitCode": {
          "type": "integer"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "completedAt",
        "operator",
        "clientVersions",
        "commands"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "operator": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9-]+$"
        },
        "clientVersions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "stateHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {
          "$ref": "#/$defs/fingerprint"
        },
        "after": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected", "observed", "outcome", "evidenceIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["not-run", "pass", "fail", "blocked"]
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "sha256",
        "redacted",
        "containsSecrets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "enum": ["log", "screenshot", "metrics", "json", "checksum", "report"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "redacted": {
          "type": "boolean"
        },
        "containsSecrets": {
          "const": false
        }
      }
    },
    "authorizationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalRole",
        "restrictionState",
        "eventKind",
        "outcome",
        "eventPersisted",
        "clientError",
        "rawDatabaseTextObserved"
      ],
      "properties": {
        "principalRole": {
          "enum": ["owner", "admin", "member"]
        },
        "restrictionState": {
          "enum": [
            "active-ban",
            "active-timeout",
            "expired-ban",
            "expired-timeout",
            "none"
          ]
        },
        "eventKind": {
          "enum": [
            9030, 9031, 9032, 9033, 41010, 41011, 41012, 30620, 46020, 46030,
            46031
          ]
        },
        "outcome": {
          "enum": ["accepted", "rejected"]
        },
        "eventPersisted": {
          "type": "boolean"
        },
        "clientError": {
          "type": ["string", "null"]
        },
        "rawDatabaseTextObserved": {
          "type": "boolean"
        }
      }
    },
    "channelOwnerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelId", "activeOwnerPubkeys"],
      "properties": {
        "channelId": {
          "$ref": "#/$defs/publicKey"
        },
        "activeOwnerPubkeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicKey"
          }
        }
      }
    },
    "roleAuthorizationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateHash", "ownerPubkeys", "channels"],
      "properties": {
        "stateHash": {
          "$ref": "#/$defs/fingerprint"
        },
        "ownerPubkeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicKey"
          }
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/channelOwnerState"
          }
        }
      }
    },
    "roleAuthorizationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant",
        "actorRole",
        "outcome",
        "eventPersisted",
        "clientError",
        "rawDatabaseTextObserved",
        "before",
        "after"
      ],
      "properties": {
        "invariant": {
          "enum": [
            "non-admin-role-change-rejected",
            "owner-demotion-rejected",
            "owner-set-preserved",
            "active-owner-per-channel"
          ]
        },
        "actorRole": {
          "enum": ["owner", "admin", "member", "unauthorized"]
        },
        "outcome": {
          "const": "rejected"
        },
        "eventPersisted": {
          "const": false
        },
        "clientError": {
          "const": "request rejected"
        },
        "rawDatabaseTextObserved": {
          "const": false
        },
        "before": {
          "$ref": "#/$defs/roleAuthorizationState"
        },
        "after": {
          "$ref": "#/$defs/roleAuthorizationState"
        }
      }
    },
    "roleAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/roleAuthorizationCase"
          }
        }
      }
    },
    "authorizationRegression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "roleAuthorization"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 99,
          "maxItems": 99,
          "items": {
            "$ref": "#/$defs/authorizationCase"
          }
        },
        "roleAuthorization": {
          "$ref": "#/$defs/roleAuthorization"
        }
      }
    },
    "restoreEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "model",
        "cpu",
        "cores",
        "memoryBytes",
        "storage",
        "startosBuildId",
        "startosImageSha256"
      ],
      "properties": {
        "architecture": {
          "enum": ["x86_64", "aarch64"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        },
        "startosBuildId": {
          "type": "string",
          "minLength": 1
        },
        "startosImageSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "restoreTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "nativePackageReinstalled", "outcome"],
      "properties": {
        "source": {
          "$ref": "#/$defs/restoreEndpoint"
        },
        "target": {
          "$ref": "#/$defs/restoreEndpoint"
        },
        "nativePackageReinstalled": {
          "type": "boolean"
        },
        "outcome": {
          "const": "pass"
        }
      }
    },
    "upgradeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "version",
        "packageCommit",
        "upstreamCommit",
        "signerFingerprint",
        "artifact"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "packageCommit": {
          "$ref": "#/$defs/commit"
        },
        "upstreamCommit": {
          "$ref": "#/$defs/commit"
        },
        "signerFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256"],
          "properties": {
            "name": {
              "enum": ["buzz_x86_64.s9pk", "buzz_aarch64.s9pk"]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "severity", "status"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "severity": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "status": {
          "enum": ["open", "resolved"]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "decision", "notes"],
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9-]+$"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": ["pending", "approved", "rejected"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
