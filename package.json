{
  "name": "buzz-startos",
  "scripts": {
    "audit:signatures": "npm audit signatures",
    "audit:vulnerabilities": "tsx scripts/check-vulnerability-waivers.ts npm",
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "check": "tsc --noEmit",
    "prettier": "prettier --write startos tests scripts",
    "prettier:check": "prettier --check startos tests scripts",
    "scan:images": "scripts/scan-runtime-images.sh",
    "test": "tsx --test tests/*.test.ts",
    "verify:images": "tsx scripts/verify-images.ts",
    "verify:device-evidence": "tsx scripts/validate-device-evidence.ts",
    "verify:device-promotion": "tsx scripts/validate-device-evidence.ts --promotion"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "nostr-tools": "2.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/semver": "7.7.1",
    "@vercel/ncc": "^0.44.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "^3.6.2",
    "semver": "7.8.5",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "yaml": "2.9.0"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  }
}
